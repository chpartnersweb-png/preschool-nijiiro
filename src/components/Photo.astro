---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  position?: string;
  reveal?: boolean;
}
const { src, alt, class: className = '', sizes = '(max-width: 767px) 90vw, 50vw', position = 'center', reveal = true } = Astro.props;
---
<figure class:list={['photo', className]} data-reveal={reveal ? '' : undefined}>
  <Image src={src} alt={alt} widths={[400, 700, 1000, 1400]} sizes={sizes} format="webp" quality={83} loading="lazy" decoding="async" style={`object-position: ${position}`} />
</figure>
